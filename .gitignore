# python
# `.venv*` menangkap venv utama sekaligus salinan sementara seperti
# `.venv-anaconda-broken/` (lihat catatan WinError 1114 di README) — venv tidak
# pernah boleh masuk git: isinya biner khusus mesin, ratusan MB.
.venv/
.venv*/
__pycache__/
*.py[cod]
.pytest_cache/

# node / next
node_modules/
.next/
out/

# runtime data (sqlite db, process logs)
data/

# downloaded GGUF models (ratusan MB–GB; jangan pernah masuk git)
models/
*.gguf
*.gguf.part

# env
.env
.env.local

# misc
.DS_Store
*.log
frontend/tsconfig.tsbuildinfo
