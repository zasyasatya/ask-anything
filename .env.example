# ============================================================
# Ask Anything — Contoh konfigurasi (salin ke .env)
# ============================================================

# Provider: huggingface | openai | mock
ASK_PROVIDER=openai

# OpenAI credentials
ASK_OPENAI_API_KEY=sk-your-key-here
ASK_OPENAI_BASE_URL=https://api.openai.com/v1
ASK_OPENAI_MODEL=gpt-4o-mini

# HuggingFace
ASK_HF_BASE_URL=http://127.0.0.1:8081/v1
ASK_HF_API_KEY=
ASK_HF_TOKEN=

# Generation
ASK_TEMPERATURE=0.7
ASK_MAX_TOKENS=2048
ASK_MAX_STEPS=6

# Search
ASK_SEARCH_BACKEND=ddg
ASK_SERPER_API_KEY=
ASK_TAVILY_API_KEY=

# Deep Research
ASK_DEEP_RESEARCH_MAX_QUERIES=6
ASK_DEEP_RESEARCH_MAX_RESULTS_PER_QUERY=8
