# --- Provider LLM: huggingface | openai | mock ---
ASK_PROVIDER=huggingface

# --- HuggingFace lokal (hf_mode=local) / server OpenAI-compatible ---
ASK_HF_MODE=local
ASK_HF_MODEL=
# ASK_HF_BASE_URL=http://127.0.0.1:8081/v1
# ASK_HF_API_KEY=

# --- OpenAI / gateway ---
ASK_OPENAI_BASE_URL=https://api.openai.com/v1
ASK_OPENAI_MODEL=gpt-4o-mini
# ASK_OPENAI_API_KEY=sk-...

# --- Pipeline governance (halaman Admin) ---
# Bila diset, semua endpoint /api/admin/* mewajibkan header X-Admin-Token.
# Kosong = konsol admin terbuka (mode lokal/demo).
ASK_ADMIN_TOKEN=

# --- Task management (halaman /tasks) ---
# Isi papan dengan rencana RAG saat tabel task masih kosong.
ASK_TASKS_AUTOSEED=true
# Folder repo git untuk sinkronisasi branch/commit task (kosong = root proyek).
ASK_REPO_DIR=

# --- Storage (path relatif = terhadap root proyek) ---
# Nilai lokal di bawah; di Docker/Coolify semuanya otomatis menunjuk ke
# /app/data/... (satu volume persisten) — lihat Dockerfile + docker-compose.yml.
# JANGAN arahkan ke luar volume di produksi, atau data hilang saat redeploy.
ASK_DB_PATH=data/ask_anything.db
ASK_ARTIFACTS_DIR=data/artifacts
ASK_RAG_DIR=data/rag
ASK_MODELS_DIR=models
