# --- Provider LLM: huggingface | openai | mock ---
ASK_PROVIDER=huggingface

# --- HuggingFace lokal (hf_mode=local) / server OpenAI-compatible ---
ASK_HF_MODE=local
ASK_HF_MODEL=
# ASK_HF_BASE_URL=http://127.0.0.1:8081/v1
# ASK_HF_API_KEY=

# --- OpenAI / gateway ---
ASK_OPENAI_BASE_URL=https://api.openai.com/v1
ASK_OPENAI_MODEL=gpt-4o-mini
# ASK_OPENAI_API_KEY=sk-...

# --- Pipeline governance (halaman Admin) ---
# Bila diset, semua endpoint /api/admin/* mewajibkan header X-Admin-Token.
# Kosong = konsol admin terbuka (mode lokal/demo).
ASK_ADMIN_TOKEN=

# --- Akun anak internship (papan /internship) ---
# Dibuat otomatis saat backend start bila belum ada (juga di database lama).
# Login boleh memakai username ATAU email.
ASK_INTERN_USERNAME=verisimb
ASK_INTERN_EMAIL=verisimb@gmail.com
ASK_INTERN_NAME=Very Irawan Simbolon
# Kosong = password acak dibuatkan sekali: dicetak ke log startup DAN ditulis ke
# <folder data>/intern-credentials.txt. Hapus berkas itu setelah diserahkan.
ASK_INTERN_PASSWORD=

# --- Task management (halaman /tasks) ---
# Isi papan dengan rencana RAG saat tabel task masih kosong.
ASK_TASKS_AUTOSEED=true
# Folder repo git untuk sinkronisasi branch/commit task (kosong = root proyek).
ASK_REPO_DIR=

# --- Storage: SATU direktori untuk semua state persisten ---
# Isi: ask_anything.db (SQLite) + artifacts/ + rag/ + models/ + backups/.
# Lokal  : data/ (relatif = terhadap root proyek).
# Server : titik mount disk server, mis. /app/data yang di-bind ke
#          /opt/ask-anything/data (Coolify: Storages -> Directory Mount).
# Container MENOLAK start bila direktori ini bukan mount point — biar salah
# konfigurasi ketahuan di log deploy, bukan setelah data hilang.
ASK_DATA_DIR=data
# Opsional: hanya isi bila satu bagian harus pindah ke disk lain. Dibiarkan
# kosong = mengikuti ASK_DATA_DIR di atas.
# ASK_DB_PATH=
# ASK_ARTIFACTS_DIR=
# ASK_RAG_DIR=
ASK_MODELS_DIR=models
# Uji coba/CI yang memang boleh kehilangan data: 1 = lewati gerbang mount.
# JANGAN diisi di produksi.
# ASK_ALLOW_EPHEMERAL_DATA=0
